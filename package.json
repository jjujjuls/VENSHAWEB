{
  "name": "venshaskin-platform",
  "version": "2.0.0",
  "description": "VENSHA SKIN client portal and admin management system",
  "type": "module",
  "scripts": {
    "dev": "node --watch server/src/index.js",
    "start": "node server/src/index.js",
    "build": "npx prisma generate --schema=server/prisma/schema.prisma",
    "postinstall": "npx prisma generate --schema=server/prisma/schema.prisma",
    "db:push": "npx prisma db push --schema=server/prisma/schema.prisma",
    "db:seed": "node server/prisma/seed.js",
    "vercel-build": "npx prisma generate --schema=server/prisma/schema.prisma && npx prisma db push --schema=server/prisma/schema.prisma --accept-data-loss"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0",
    "@supabase/supabase-js": "^2.49.0",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "resend": "^4.0.0"
  },
  "devDependencies": {
    "prisma": "^6.5.0"
  }
}
