generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  GUEST
  CLIENT
  ADMIN
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  RESCHEDULED
}

enum NotificationChannel {
  WEBSITE
  EMAIL
  SMS
}

enum PromotionStatus {
  DRAFT
  ACTIVE
  EXPIRED
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  passwordHash      String?
  firstName         String
  lastName          String
  phone             String?
  role              Role      @default(CLIENT)
  emailVerified     Boolean   @default(false)
  verifyToken       String?
  resetToken        String?
  resetTokenExpiry  DateTime?
  memberSince       DateTime  @default(now())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  membershipProgress MembershipProgress?
  appointments       Appointment[]
  consultations      Consultation[]
  machineInquiries   MachineInquiry[]
  notifications      Notification[]
  messages           Message[]
  rewards            Reward[]
}

model MembershipLevel {
  id                    String   @id @default(cuid())
  name                  String
  slug                  String   @unique
  description           String
  minConsultations      Int      @default(0)
  benefits              String
  colorTheme            String
  frontCardImageUrl     String?
  backCardImageUrl      String?
  badgeImageUrl         String?
  rewardDescription     String?
  discountPercent       Float?
  priority              Int      @default(0)
  displayOrder          Int      @default(0)
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  members MembershipProgress[]
}

model MembershipProgress {
  id                String   @id @default(cuid())
  userId            String   @unique
  membershipLevelId String
  sessionsCompleted Int      @default(0)
  updatedAt         DateTime @updatedAt

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  membershipLevel MembershipLevel @relation(fields: [membershipLevelId], references: [id])
}

model Consultation {
  id          String   @id @default(cuid())
  userId      String?
  name        String
  email       String
  phone       String
  treatment   String
  preferredDate String?
  preferredTime String?
  message     String?
  status      String   @default("new")
  createdAt   DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])
}

model MachineInquiry {
  id           String   @id @default(cuid())
  userId       String
  businessName String?
  phone        String
  email        String
  machineModel String   @default("Megashape Pro")
  quantity     Int      @default(1)
  intendedUse  String?
  message      String?
  status       String   @default("new")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Appointment {
  id          String            @id @default(cuid())
  userId      String
  treatment   String
  scheduledAt DateTime
  status      AppointmentStatus @default(PENDING)
  notes       String?
  reminderSent Boolean          @default(false)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EmailTemplate {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  subject   String
  bodyHtml  String
  isActive  Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

model Message {
  id         String   @id @default(cuid())
  userId     String?
  fromEmail  String
  toEmail    String
  subject    String
  body       String
  isRead     Boolean  @default(false)
  isStarred  Boolean  @default(false)
  isArchived Boolean  @default(false)
  threadId   String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])
}

model Notification {
  id        String              @id @default(cuid())
  userId    String?
  title     String
  body      String
  channel   NotificationChannel @default(WEBSITE)
  isRead    Boolean             @default(false)
  createdAt DateTime            @default(now())

  user User? @relation(fields: [userId], references: [id])
}

model Reward {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String
  discount    Float?
  redeemed    Boolean  @default(false)
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Promotion {
  id               String          @id @default(cuid())
  title            String
  description      String
  bannerImageUrl   String?
  discountPercent  Float?
  targetMembership String?
  startDate        DateTime
  endDate          DateTime
  status           PromotionStatus @default(DRAFT)
  displayLocation  String?
  createdAt        DateTime        @default(now())
}

model WebsiteContent {
  id        String   @id @default(cuid())
  key       String   @unique
  section   String
  value     String
  type      String   @default("text")
  updatedAt DateTime @updatedAt
}

model Faq {
  id           String   @id @default(cuid())
  question     String
  answer       String
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
}

model Testimonial {
  id           String   @id @default(cuid())
  author       String
  quote        String
  imageUrl     String?
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
}

model GalleryItem {
  id           String   @id @default(cuid())
  title        String?
  imageUrl     String
  caption      String?
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
}

model MediaAsset {
  id        String   @id @default(cuid())
  filename  String
  url       String
  mimeType  String
  altText   String?
  createdAt DateTime @default(now())
}

model SiteSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  eventType String
  page      String?
  metadata  String?
  createdAt DateTime @default(now())
}
