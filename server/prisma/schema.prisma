generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  GUEST
  CLIENT
  ADMIN
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  RESCHEDULED
}

enum PromotionStatus {
  DRAFT
  ACTIVE
  EXPIRED
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  passwordHash      String?
  firstName         String
  lastName          String
  phone             String?
  role              Role      @default(CLIENT)
  emailVerified     Boolean   @default(false)
  verifyToken       String?
  resetToken        String?
  resetTokenExpiry  DateTime?
  memberSince       DateTime  @default(now())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  appointments       Appointment[]
  consultations      Consultation[]
  machineInquiries   MachineInquiry[]
  messages           Message[]
  notifications      Notification[]
}

model Consultation {
  id          String   @id @default(cuid())
  userId      String?
  name        String
  email       String
  phone       String
  treatment   String
  preferredDate String?
  preferredTime String?
  message     String?
  status      String   @default("new")
  assignedTo  String?
  notes       String?
  updatedAt   DateTime @default(now()) @updatedAt
  createdAt   DateTime @default(now())

  user         User?         @relation(fields: [userId], references: [id])
  appointments Appointment[]
}

model MachineInquiry {
  id           String   @id @default(cuid())
  userId       String?
  name             String?
  companyName      String?
  businessName     String?
  businessType     String?
  purchaseTimeline String?
  phone            String
  email            String
  machineModel     String   @default("Contour Pro Max")
  quantity         Int      @default(1)
  intendedUse      String?
  message          String?
  status       String   @default("new")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id])
}

model Appointment {
  id             String            @id @default(cuid())
  userId         String
  consultationId String?
  treatment      String
  scheduledAt    DateTime
  status         AppointmentStatus @default(PENDING)
  notes          String?
  reminderSent   Boolean           @default(false)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  consultation Consultation? @relation(fields: [consultationId], references: [id])
}

model EmailTemplate {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  subject   String
  bodyHtml  String
  isActive  Boolean  @default(true)
}

model Message {
  id         String   @id @default(cuid())
  userId     String?
  fromEmail  String
  toEmail    String
  toPhone    String?
  subject    String
  body       String
  channel    String   @default("email")
  isRead     Boolean  @default(false)
  isStarred  Boolean  @default(false)
  isArchived Boolean  @default(false)
  threadId   String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])
}

model Promotion {
  id               String          @id @default(cuid())
  title            String
  description      String
  bannerImageUrl   String?
  discountPercent  Float?
  targetMembership String?
  startDate        DateTime
  endDate          DateTime
  status           PromotionStatus @default(DRAFT)
  displayLocation  String?
  createdAt        DateTime        @default(now())
}

model WebsiteContent {
  id        String   @id @default(cuid())
  key       String   @unique
  section   String
  value     String
  type      String   @default("text")
  updatedAt DateTime @updatedAt
}

model Faq {
  id           String   @id @default(cuid())
  question     String
  answer       String
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
}

model Testimonial {
  id           String   @id @default(cuid())
  author       String
  quote        String
  imageUrl     String?
  featured     Boolean  @default(false)
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
}

model GalleryItem {
  id           String   @id @default(cuid())
  title        String?
  imageUrl     String
  caption      String?
  category     String?
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
}

model Research {
  id           String   @id @default(cuid())
  title        String
  summary      String?
  content      String
  imageUrl     String?
  category     String?
  author       String?
  source       String?
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model MediaAsset {
  id        String   @id @default(cuid())
  filename  String
  url       String
  mimeType  String
  altText   String?
  createdAt DateTime @default(now())
}

model SiteSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  eventType String
  page      String?
  metadata  String?
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  channel   String   @default("WEBSITE")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
